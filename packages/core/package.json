{
  "name": "@xrpl-agent/core",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "e2e": "tsx test/escrow.e2e.ts && tsx test/payment.e2e.ts",
    "e2e:payment": "tsx test/payment.e2e.ts",
    "e2e:dex": "tsx test/dex.e2e.ts",
    "e2e:clawback": "tsx test/clawback.e2e.ts",
    "e2e:x402": "tsx test/x402.e2e.ts && tsx test/x402-tickets.e2e.ts",
    "test": "tsx test/policy.unit.ts && tsx test/x402.unit.ts && tsx test/ledger-failover.unit.ts",
    "smoke:mainnet": "tsx test/mainnet-read.smoke.ts",
    "test:offline": "tsx test/policy.unit.ts && tsx test/x402.unit.ts"
  },
  "dependencies": {
    "xrpl": "5.3.0",
    "zod": "4.6.5",
    "ripple-keypairs": "3.1.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.20.6",
    "@types/node": "22.10.2"
  },
  "license": "MIT",
  "author": "BURN",
  "homepage": "https://github.com/burnxrp/xrpl-agent-tools#readme",
  "bugs": {
    "url": "https://github.com/burnxrp/xrpl-agent-tools/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "XRPL tools for AI agents and wallets: payments, escrow, DEX/AMM, clawback, agent spending policies, x402 pay-per-request (buyer, seller, facilitator). Public XRPL nodes only.",
  "keywords": [
    "xrpl",
    "xrp-ledger",
    "xrp",
    "ai-agents",
    "mcp",
    "x402",
    "payments",
    "escrow",
    "amm",
    "dex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burnxrp/xrpl-agent-tools.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false
}
